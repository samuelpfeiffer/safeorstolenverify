# Guides legacy URLs
RewriteRule ^guides/pawnshop-buying-tips$ /for-pawn-shops [R=301,L]

# Developer/API
RewriteRule ^developer-portal$ /about [R=301,L]

# VIN lookup state redirects (states without dedicated pages)
RewriteRule ^vermont-vin-lookup$ /vin-checker [R=301,L]
RewriteRule ^michigan-vin-lookup$ /vin-checker [R=301,L]
RewriteRule ^wyoming-vin-lookup$ /vin-checker [R=301,L]
RewriteRule ^alaska-vin-lookup$ /vin-checker [R=301,L]
RewriteRule ^new-mexico-vin-lookup$ /vin-checker [R=301,L]
RewriteRule ^connecticut-vin-lookup$ /vin-checker [R=301,L]
RewriteRule ^oklahoma-vin-lookup$ /vin-checker [R=301,L]
RewriteRule ^indiana-vin-lookup$ /vin-checker [R=301,L]
RewriteRule ^kentucky-vin-lookup$ /vin-checker [R=301,L]
RewriteRule ^hawaii-vin-lookup$ /vin-checker [R=301,L]
RewriteRule ^nebraska-vin-lookup$ /vin-checker [R=301,L]
RewriteRule ^minnesota-vin-lookup$ /vin-checker [R=301,L]
RewriteRule ^mississippi-vin-lookup$ /vin-checker [R=301,L]

# License plate lookup state redirects (pattern for states flagged as duplicates)
# Note: Real pages exist - these may be for old cache issues
# If still flagged, the real pages have proper SEO now

# City subdirectory legacy
RewriteRule ^city/miami$ /stolen-check-los-angeles [R=301,L]
RewriteRule ^city/phoenix$ /stolen-check-phoenix [R=301,L]
RewriteRule ^los-angeles/imei-check$ /imei-checker [R=301,L]
RewriteRule ^chicago/imei-check$ /imei-checker [R=301,L]

# Blog redirects for timestamped posts
RewriteRule ^blog/understanding-imei-blacklists-and-what-they-mean-\d+$ /blog [R=301,L]
RewriteRule ^blog/how-law-enforcement-tracks-stolen-goods-\d+$ /blog [R=301,L]
RewriteRule ^blog/how-pawn-shops-can-prevent-buying-stolen-goods-\d+$ /blog/pawn-shop-stolen-item-verification [R=301,L]
RewriteRule ^blog/protecting-yourself-from-stolen-goods-a-buyer-s-guide-\d+$ /blog [R=301,L]
RewriteRule ^blog/how-to-verify-a-used-phone-before-buying-complete-imei-check-guide-\d+$ /blog/how-to-check-if-phone-stolen [R=301,L]
RewriteRule ^blog/iphone-16-pro-max-imei-check-complete-2025-buyer-protection-guide.*$ /blog/how-to-check-if-iphone-stolen [R=301,L]
RewriteRule ^blog/playstation-5-serial-number-verification-guide-\d*$ /check-ps5 [R=301,L]

# Other blog legacy
RewriteRule ^blog/avoid-buying-stolen-laptops$ /blog [R=301,L]
RewriteRule ^blog/business-guide-preventing-stolen-goods$ /blog [R=301,L]
RewriteRule ^blog/imei-checker-guide-2025$ /blog [R=301,L]
RewriteRule ^blog/imei-check-everything$ /blog [R=301,L]
RewriteRule ^blog/vin-verification-guide$ /blog/complete-vin-guide [R=301,L]
RewriteRule ^blog/imei-blacklist-guide$ /blog [R=301,L]
RewriteRule ^blog/verify-used-electronics-before-buying$ /blog [R=301,L]
RewriteRule ^blog/buying-used-phones-red-flags$ /blog [R=301,L]
RewriteRule ^blog/buying-used-bikes-verification-guide$ /blog [R=301,L]
RewriteRule ^blog/protect-yourself-buying-used-electronics$ /blog [R=301,L]
RewriteRule ^blog/best-imei-checker-tools-2025$ /imei-checker [R=301,L]
RewriteRule ^blog/safeorstolen-mobile-app-complete-guide-to-on-the-go-verification$ /app [R=301,L]
RewriteRule ^blog/scan-and-verify-using-safeorstolen-camera-feature$ /app [R=301,L]
RewriteRule ^blog/scan-and-verify-using-safeorstolen-camera-feature-\d*$ /app [R=301,L]

# Comparison and alternative pages
RewriteRule ^vs-stolenregister$ /compare [R=301,L]
RewriteRule ^referral$ /pricing [R=301,L]
RewriteRule ^imei-checker-app$ /app [R=301,L]

# FasterCapital legacy
RewriteRule ^fastercapital/raise-capital$ /about [R=301,L]
RewriteRule ^fastercapital/tech-cofounder$ /about [R=301,L]

# Pattern-based catch-alls (place after specific rules)
RewriteRule ^(.+)-stolen-item-check$ /verify [R=301,L]

# ===================================
# Bot Detection & Prerendered Content
# ===================================
# Serve prerendered static HTML to search engine bots
RewriteCond %{HTTP_USER_AGENT} (googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|facebookexternalhit|twitterbot|linkedinbot|whatsapp|slackbot|telegrambot) [NC]
RewriteCond %{REQUEST_URI} !^/_prerendered/
RewriteCond %{DOCUMENT_ROOT}/_prerendered%{REQUEST_URI}.html -f
RewriteRule ^(.*)$ /_prerendered/$1.html [L]

# Serve prerendered index for bot homepage requests
RewriteCond %{HTTP_USER_AGENT} (googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|facebookexternalhit|twitterbot|linkedinbot|whatsapp|slackbot|telegrambot) [NC]
RewriteCond %{REQUEST_URI} ^/$
RewriteCond %{DOCUMENT_ROOT}/_prerendered/index.html -f
RewriteRule ^$ /_prerendered/index.html [L]

# Force HTTPS and redirect www to non-www (canonical URL)
# Handle all combinations: http://www, https://www, http://non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://safeorstolen.com/$1 [R=301,L]

# Additional safety net for any remaining www redirects
RewriteCond %{HTTP_HOST} ^www\.safeorstolen\.com$ [NC]
RewriteRule ^(.*)$ https://safeorstolen.com/$1 [R=301,L]

# Remove trailing slashes (except for root) to prevent duplicate content
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^(.*)$ /$1 [R=301,L]

# Handle SPA routing - serve index.html for routes that don't match files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/admin/
RewriteCond %{REQUEST_URI} !^/sitemap\.xml$
RewriteCond %{REQUEST_URI} !^/robots\.txt$
RewriteCond %{REQUEST_URI} !^/manifest\.json$
RewriteCond %{REQUEST_URI} !\.(js|css|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot|xml|txt|json)$
RewriteRule . /index.html [L]

# Custom 404 error page
ErrorDocument 404 /index.html

# Security headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always append X-Frame-Options SAMEORIGIN
    
    # XSS protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options nosniff
    
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # HSTS (if using HTTPS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Cache optimization
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    
    # CSS and JS
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    
    # HTML
    ExpiresByType text/html "access plus 0 seconds"
    
    # Sitemap
    ExpiresByType application/xml "access plus 1 day"
    ExpiresByType text/xml "access plus 1 day"
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>