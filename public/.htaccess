RewriteRule ^buyer-guide$ /verify [R=301,L]

# International VIN checks
RewriteRule ^uk-vehicle-check$ /vin-checker [R=301,L]
RewriteRule ^australia-vin-check$ /vin-checker [R=301,L]
RewriteRule ^canada-vin-check$ /vin-checker [R=301,L]

# Item checker legacy URLs
RewriteRule ^check-fender-guitar$ /serial-number-checker [R=301,L]
RewriteRule ^check-violin$ /serial-number-checker [R=301,L]
RewriteRule ^check-rolex$ /serial-number-checker [R=301,L]
RewriteRule ^check-power-tools$ /serial-number-checker [R=301,L]
RewriteRule ^check-gaming-console$ /check-electronics [R=301,L]
RewriteRule ^check-drone$ /verify [R=301,L]

# Business/info page redirects
RewriteRule ^crime-prevention-impact$ /about [R=301,L]
RewriteRule ^ultimate-guide$ /about [R=301,L]
RewriteRule ^stolen-search-console$ /verify [R=301,L]
RewriteRule ^auction-houses$ /for-auction-houses [R=301,L]
RewriteRule ^careers$ /about [R=301,L]
RewriteRule ^trust-verification$ /about [R=301,L]
RewriteRule ^statistics$ /about [R=301,L]
RewriteRule ^accuracy$ /about [R=301,L]
RewriteRule ^our-story$ /about [R=301,L]
