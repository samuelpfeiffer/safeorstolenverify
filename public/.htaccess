RewriteRule ^app/buyers$ /app [R=301,L]
RewriteRule ^app/features/push-notifications$ /app/features [R=301,L]
RewriteRule ^app/features/history$ /app/features [R=301,L]

# Legacy verification and tool URLs
RewriteRule ^verification-app$ /app [R=301,L]
RewriteRule ^mobile-verification$ /app [R=301,L]
RewriteRule ^ios-app$ /app [R=301,L]
RewriteRule ^android-app$ /app [R=301,L]
RewriteRule ^database$ /stolen-database [R=301,L]
