RewriteRule ^kentucky-stolen-item-check$ /verify [R=301,L]
RewriteRule ^hawaii-stolen-item-check$ /verify [R=301,L]
RewriteRule ^vermont-stolen-item-check$ /verify [R=301,L]
RewriteRule ^indiana-stolen-item-check$ /verify [R=301,L]
RewriteRule ^new-york-stolen-item-check$ /verify [R=301,L]
RewriteRule ^new-jersey-stolen-item-check$ /verify [R=301,L]
RewriteRule ^austin-stolen-item-check$ /verify [R=301,L]
RewriteRule ^tucson-stolen-item-check$ /verify [R=301,L]
RewriteRule ^atlanta-stolen-item-check$ /verify [R=301,L]
RewriteRule ^columbus-stolen-item-check$ /verify [R=301,L]
RewriteRule ^oakland-stolen-item-check$ /verify [R=301,L]
RewriteRule ^san-francisco-stolen-item-check$ /verify [R=301,L]

