# Enhanced .htaccess for Safe Or Stolen
# Handle SPA routing, SEO optimization, and bot prerendering

# Enable rewrite engine
RewriteEngine On

# ===================================
# GSC NOINDEX FIX - 301 Redirects for Legacy URLs
# These must come BEFORE SPA fallback to prevent NotFound/noindex
# Last updated: 2026-02-04
# ===================================

# Legacy state stolen-item-check URLs → /verify
RewriteRule ^arkansas-stolen-item-check$ /verify [R=301,L]
