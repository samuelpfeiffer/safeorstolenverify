# ============================================
# SafeOrStolen HTTP Headers
# Prerender.io Integration + Security + Caching
# ============================================

# Global headers for all pages
/*
  X-Prerender-Token: iiMthWrIIiQhunohL2U5
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self)

# HTML pages - no cache for fresh content
/
  Cache-Control: no-cache, must-revalidate, max-age=0

/index.html
  Cache-Control: no-cache, must-revalidate, max-age=0

# Static assets - long cache (they have content hashes)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images - moderate cache
/images/*
  Cache-Control: public, max-age=86400

# Sitemap and robots - short cache for crawlers
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
