# ============================================
# SafeOrStolen HTTP Headers
# 2026 Compliant: Security + Caching + Prerendering
# ============================================

# Global headers for all pages
/*
  X-Prerender-Token: iiMthWrIIiQhunohL2U5
  X-Frame-Options: SAMEORIGIN
  Content-Signal: ai-train=yes, search=yes, ai-input=yes
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block

# HTML pages - no cache for fresh content
/
  Cache-Control: no-cache, must-revalidate, max-age=0

/index.html
  Cache-Control: no-cache, must-revalidate, max-age=0

# Static assets - long cache (they have content hashes)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images - moderate cache
/images/*
  Cache-Control: public, max-age=86400

# Sitemap and robots - short cache for crawlers
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

# AI discovery files - moderate cache
/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/ai.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/ai-context.json
  Cache-Control: public, max-age=86400
  Content-Type: application/json; charset=utf-8

/identity.json
  Cache-Control: public, max-age=86400
  Content-Type: application/json; charset=utf-8

/.well-known/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/.well-known/ai-plugin.json
  Cache-Control: public, max-age=86400
  Content-Type: application/json; charset=utf-8

# Static HTML fallback for AI bots
/llm.html
  Cache-Control: public, max-age=86400
