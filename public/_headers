# Cache control headers for deployment platforms (Netlify, Vercel, Cloudflare)

# No cache for HTML files - always fetch fresh
/
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/index.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# Aggressive cache for hashed assets (they have unique names on each build)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker files - no cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0

/sw-secure.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0

/sw-unregister.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
