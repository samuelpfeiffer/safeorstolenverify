# Lovable Platform Redirects for Safe Or Stolen
# Force canonical domain: https://safeorstolen.com (non-www, HTTPS only)

# CRITICAL: Force all HTTP to HTTPS (eliminate all HTTP redirects)
http://safeorstolen.com/* https://safeorstolen.com/:splat 301!
http://www.safeorstolen.com/* https://safeorstolen.com/:splat 301!

# Force www to non-www (already HTTPS) - CRITICAL FOR GOOGLE INDEXING  
https://www.safeorstolen.com/* https://safeorstolen.com/:splat 301!

# Ensure trailing slash consistency for canonical URLs
https://safeorstolen.com/*/ https://safeorstolen.com/:splat 301!

# Specific redirects for pages that were returning 404s
/terms /terms-of-service 301

# Handle API routes (don't redirect)
/api/* /api/:splat 200

# Static assets should serve correctly
/*.js /:splat 200
/*.css /:splat 200
/*.png /:splat 200
/*.jpg /:splat 200
/*.jpeg /:splat 200
/*.gif /:splat 200
