# Netlify/Modern Platform Redirects for Safe Or Stolen
# Force canonical domain: https://safeorstolen.com (non-www)

# Redirect all www traffic to non-www (301 permanent redirect)  
https://www.safeorstolen.com/* https://safeorstolen.com/:splat 301!
http://www.safeorstolen.com/* https://safeorstolen.com/:splat 301!

# Force HTTPS for non-www traffic
http://safeorstolen.com/* https://safeorstolen.com/:splat 301!

# Specific redirects for pages that were returning 404s
/terms /terms-of-service 301

# Handle API routes (don't redirect)
/api/* /api/:splat 200

# Static assets should serve correctly
/*.js /:splat 200
/*.css /:splat 200
/*.png /:splat 200
/*.jpg /:splat 200
/*.jpeg /:splat 200
/*.gif /:splat 200
/*.svg /:splat 200
/*.webp /:splat 200
/*.ico /:splat 200
/*.woff /:splat 200
/*.woff2 /:splat 200
/*.ttf /:splat 200
/*.eot /:splat 200
/*.xml /:splat 200
/*.txt /:splat 200
/*.json /:splat 200

# SPA fallback - serve index.html for all other routes
/* /index.html 200