{
  "name": "SafeOrStolen",
  "short_name": "SafeOrStolen",
  "description": "Check if a used phone, car, gun, tool or bike was reported stolen. Enter the IMEI, VIN, plate or serial number, or scan its barcode. Checks need an internet connection.",
  "start_url": "/app?source=pwa",
  "id": "com.safeorstolen.app",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay"
  ],
  "background_color": "#0d0d0d",
  "theme_color": "#FF6B35",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en-US",
  "dir": "ltr",
  "categories": [
    "security",
    "utilities",
    "productivity",
    "business",
    "shopping"
  ],
  "screenshots": [
    {
      "src": "/lovable-uploads/ec9c0592-2bc2-4148-b85a-82ff5342c0f8.png",
      "sizes": "1200x630",
      "type": "image/png",
      "platform": "wide",
      "label": "SafeOrStolen stolen item verification platform"
    }
  ],
  "icons": [
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Check IMEI",
      "short_name": "IMEI Check",
      "description": "Check if phone is stolen by IMEI",
      "url": "/verify?type=imei&source=shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Check VIN",
      "short_name": "VIN Check",
      "description": "Check if vehicle is stolen by VIN",
      "url": "/verify?type=vin&source=shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Scan Barcode",
      "short_name": "Scan",
      "description": "Scan item barcode with camera",
      "url": "/verify?scan=true&source=shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Verification History",
      "short_name": "History",
      "description": "View your verification history",
      "url": "/dashboard?source=shortcut",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "share_target": {
    "action": "/verify",
    "method": "GET",
    "params": {
      "text": "q"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+safeorstolen",
      "url": "/verify?q=%s"
    }
  ]
}
