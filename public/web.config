<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Handle SPA routing for IIS servers -->
    <rewrite>
      <rules>
        <!-- Redirect www to non-www and force HTTPS -->
        <rule name="Redirect to non-WWW" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.safeorstolen\.com$" />
          </conditions>
          <action type="Redirect" url="https://safeorstolen.com/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Force HTTPS -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://safeorstolen.com/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- =====================================================================
             Legacy path 301s. These MUST stay above the SPA catch-all rewrite so
             a crawler receives a real 301 instead of a 200 homepage shell.
             The React equivalents in src/core/routing/RedirectRoutes.tsx remain
             in place for in-app navigation.
             ===================================================================== -->
        <rule name="301 ai-imei-check" stopProcessing="true">
          <match url="^ai-imei-check/?$" />
          <action type="Redirect" url="/imei-checker" redirectType="Permanent" />
        </rule>
        <rule name="301 ai-license-plate-check" stopProcessing="true">
          <match url="^ai-license-plate-check/?$" />
          <action type="Redirect" url="/license-plate-lookup" redirectType="Permanent" />
        </rule>
        <rule name="301 ai-serial-number-check" stopProcessing="true">
          <match url="^ai-serial-number-check/?$" />
          <action type="Redirect" url="/serial-number-checker" redirectType="Permanent" />
        </rule>
        <rule name="301 firearms-serial-check" stopProcessing="true">
          <match url="^firearms-serial-check/?$" />
          <action type="Redirect" url="/firearms-serial-number-check" redirectType="Permanent" />
        </rule>
        <rule name="301 imei" stopProcessing="true">
          <match url="^imei/?$" />
          <action type="Redirect" url="/imei-checker" redirectType="Permanent" />
        </rule>

        <!-- Don't rewrite files that exist -->
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(api)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>
      </rules>
    </rewrite>

    <!-- Security headers -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>

    <!-- MIME types -->
    <staticContent>
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <mimeMap fileExtension=".txt" mimeType="text/plain" />
    </staticContent>
  </system.webServer>

  <!-- =========================================================================
       X-Robots-Tag: noindex, follow for private / app-shell-only paths.
       Delivered in the HTTP response so the directive does not depend on JS.
       Scoped per path via <location>, so the static IndexNow key .txt files at
       the site root and every public content route are unaffected.
       ========================================================================= -->
  <location path="verify">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="X-Robots-Tag" value="noindex, follow" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="dashboard">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="X-Robots-Tag" value="noindex, follow" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="auth">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="X-Robots-Tag" value="noindex, follow" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="app">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="X-Robots-Tag" value="noindex, follow" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="mobile-dashboard">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="X-Robots-Tag" value="noindex, follow" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="mobile-onboarding">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="X-Robots-Tag" value="noindex, follow" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="mobile-settings">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="X-Robots-Tag" value="noindex, follow" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="mobile-verify">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="X-Robots-Tag" value="noindex, follow" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="trust-engine">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="X-Robots-Tag" value="noindex, follow" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
